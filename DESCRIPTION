Package: progme
Type: Package
Title: Extended Progression Models for Repeated Measures
Version: 0.1.0
Authors@R: c(
    person("Mukul", "Bijalwan", email = "mukulbijalwan555@gmail.com",
           role = c("aut", "cre"),
           comment = c(ORCID = "0009-0001-3040-6912")),
    person("Gunjan", "Aggrwal", role = "aut"),
